SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Хосты db и redis — имена сервисов в docker-compose.
# При запуске без Docker меняем их на localhost.
DB_NAME=sp_lms
DB_USER=sp_lms
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

STRIPE_API_KEY=
STRIPE_CURRENCY=rub
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/payments/success/
STRIPE_CANCEL_URL=http://127.0.0.1:8000/payments/cancel/

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

EMAIL_USE_CONSOLE=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
